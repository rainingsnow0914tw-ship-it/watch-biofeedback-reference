<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 宣告這是手錶 app。沒有這行，系統會當成手機 app -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!--
         adb -s <watch> shell pm grant com.example.watchbridge android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 讀心率必要。可以用 adb 授：
         adb -s <watch> shell pm grant com.example.watchbridge android.permission.BODY_SENSORS -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 螢幕關著也要繼續量的話需要這個（Android 12 以上） -->
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <!-- 之後要把資料送到電腦時用得到 -->
    <!--
         ACCELEROMETER_CONTINUOUS 會直接回 PERMISSION_ERROR。
         · ACTIVITY_RECOGNITION      —— 動作偵測（執行時權限，要 grant）
         · HIGH_SAMPLING_RATE_SENSORS —— Android 12 起，高於 200Hz 的取樣要它 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 長駐收集服務。沒有這幾個，螢幕一暗系統就把 app 凍結，
         -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 重開機之後自己爬起來。沒有這個，手錶重開一次收集就永遠停了，
         而且**完全看不出來**（錶面正常、圖示在、沒有錯誤）。
         -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
         後果：震動被系統擋掉，但呼叫包在 runCatching 裡 —— **安靜地失敗**。
         **沒有確認手腕有沒有感覺到**，所以完全沒發現。

         這件事的嚴重性在於：**震動是警報唯一的輸出通道**。
         沒有這行，之後做的警報會是一個完全靜音的警報器 ——
         -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
         在此之前錄音只能靠 adb 撈，而無線偵錯會自己關 ——
         ⚠ 這是 runtime 權限，裝完要 `pm grant`，不然 scan() 會靜靜地看不到東西。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!--
         裝完用 adb 授：adb shell pm grant com.example.watchbridge android.permission.RECORD_AUDIO -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
         排程會被直接拒絕 —— 而且是排的時候才拒，不是啟動時。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
           · 前景服務直接 startActivity          → BAL_BLOCK
           · 走全螢幕通知讓系統代發（正規做法）  → 一樣 BAL_BLOCK
             （日誌顯示 balAllowedByPiCreator=ALLOW_BAL、balAllowedByPiSender=ALLOW_BAL，
               而 resultIfPiSenderAllowsBal=BAL_BLOCK —— 兩邊都說可以，結果還是擋）
         連 Samsung 自己的 wearable.sysui 代發都被否決。

         覆蓋視窗是**不經過 Activity** 的，BAL 那套規則管不到它。
         代價：這個權限要手動授予（設定裡找不到就用 adb），恢復原廠要重下。
             adb shell appops set com.example.watchbridge SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ico_bridge"
        android:label="阿寶橋接"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:icon="@drawable/ico_bridge"
            android:exported="true"
            android:label="阿寶橋接"
            android:keepScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             錶冠按兩下的自訂按鍵設定只列得出可以被外部啟動的 activity。
             taskAffinity 留空 + excludeFromRecents：按完就結束，
             不要留在最近工作列裡擋路。 -->
        <!--

             查證：dumpsys 顯示同一個 task #15 裡疊了兩個 MarkActivity
                 Hist #1: ActivityRecord{1708485  ...}   上面那個
                 Hist #0: ActivityRecord{142417238 ...}  下面還有一個
             launchMode 原本是預設的 standard，所以每次啟動都新開一個實例

             singleTask = 再收到啟動意圖時重用既有實例，並清掉它上面的東西。
             配合程式裡的 finishAndRemoveTask() 一起修。 -->
        <activity
            android:name=".MarkActivity"
            android:exported="true"
            android:icon="@drawable/ico_mark"
            android:label="記一筆"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             SayService：手機 /say 送一句話來 → 震一下 → 錶的語音引擎唸出來 ＋ 一則通知。
             ⚠ MESSAGE_RECEIVED 的 pathPrefix 跟 WearReceiver 那條一樣：
               少宣告一行就整條路安靜不通，不會有任何錯誤訊息。 -->
        <activity
            android:name=".TalkActivity"
            android:exported="true"
            android:icon="@drawable/ico_talk"
            android:label="跟阿寶說"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
             記一筆最底下也有入口。它只送廣播，感測器仍由 CollectorService 一個主人管。 -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:icon="@drawable/ico_ecg"
            android:label="量心電圖"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:keepScreenOn="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HistoryActivity"
            android:exported="true"
            android:icon="@drawable/ico_history"
            android:label="阿寶說過"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".VoiceVolumeActivity"
            android:exported="false"
            android:label="阿寶音量"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />
        <activity
            android:name=".SayCardActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/SayCardTheme" />
        <!--
             白名單只有 status/log/restart_collector/wifi_on/wifi_off，不能裝、不能刪。 -->
        <service
            android:name=".DiagService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/diag" />
            </intent-filter>
        </service>
        <service
            android:name=".SayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/say" />
            </intent-filter>
        </service>

        <!-- 監聽三星原生跌倒偵測發出的通知。
             這是目前找到**唯一能即時拿到那個訊號**的管道 ——
             safety_assistance 有 SOS 通知頻道（mId=8280），而通知是推播不是輪詢。

             ⚠ 授權要用 adb（手錶上那個設定頁很難找）：
               adb shell cmd notification allow_listener                  com.example.watchbridge/com.example.watchbridge.FallWatcher
             恢復原廠或重新配對之後要重下一次。 -->
        <service
            android:name=".FallWatcher"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
             這個畫面的讀者**不是配戴者**，是扶起他的那個陌生人 —— 見 AlarmActivity 檔頭。

             · showWhenLocked / turnScreenOn：螢幕是黑的、錶還鎖著也要亮起來
             · excludeFromRecents：警報不該留在最近工作列裡
             · exported=false：只有自己叫得動，不需要外部啟動
             · launchMode=singleTask：連續觸發不要疊出好幾層關不完 -->
        <activity
            android:name=".KeepWifiActivity"
            android:exported="true"
            android:icon="@drawable/ico_wifi"
            android:label="保持Wi-Fi"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MotionLabActivity"
            android:exported="true"
            android:icon="@drawable/ico_motion"
            android:label="錄動作"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service
            android:name=".CollectorService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- ⚠ 這裡**刻意不用** directBootAware / LOCKED_BOOT_COMPLETED。
             但 CollectorService 要寫的 filesDir 屬於憑證加密儲存區，
             **解鎖前根本掛載不到** —— 服務會起來然後寫檔全部失敗，
             而且是安靜地失敗。
             要支援解鎖前收集，得整個改用 device-protected storage，
             那是另一件事，現在不做。 -->

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 傳送用的鬧鐘。**一定要在這裡宣告**：
             動態註冊的 receiver 跟著行程一起死，行程沒了鬧鐘就送不到 ——

             exported=false：只有系統的鬧鐘會叫它，不需要別的 app 叫得到。 -->
        <receiver
            android:name=".SendAlarm"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
